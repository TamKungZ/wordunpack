{
  "name": "@wordunpack/gloss-ja-th",
  "version": "0.1.0",
  "description": "Seed Japanese-to-Thai gloss provider for particles and common learner grammar.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@wordunpack/core": "0.1.0"
  }
}
